---
interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<section class="section">
  <div class="wrap">
    <h2>Questions</h2>
    <div class="faq">
      {
        items.map((item) => (
          <div class="faq-item">
            <h3>{item.question}</h3>
            <p class="measure">{item.answer}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
