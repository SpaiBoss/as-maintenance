---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { servicePages } from "../config/site";
import { photoAlt, photos } from "../lib/photos";
---

<Base
  title="Page not found | A&S Maintenance"
  description="This page is not on the A&S Maintenance site. Browse Twin Cities handyman services or call 612-707-3149."
>
  <PageHero
    title="Page not found"
    lede="That page is not here. Try a service below, or call or text for a free estimate."
    image={photos.hero}
    imageAlt={photoAlt.hero}
  />

  <section class="section">
    <div class="wrap">
      <h2>Services</h2>
      <ul class="link-list">
        <li><a href="/">Home</a></li>
        {
          servicePages.map((service) => (
            <li>
              <a href={service.href}>{service.title}</a>
            </li>
          ))
        }
        <li><a href="/service-area/">Service area</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </div>
  </section>
</Base>
