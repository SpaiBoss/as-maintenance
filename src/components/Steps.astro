---
interface Step {
  title: string;
  text: string;
}

interface Props {
  steps: Step[];
  heading?: string;
}

const { steps, heading = "How it works" } = Astro.props;
---

<section class="section section-band">
  <div class="wrap">
    <div class="section-head">
      <h2>{heading}</h2>
      <p class="section-lede">Text a photo, get a free estimate, then book. No forms on this site.</p>
    </div>
    <ol class="steps">
      {
        steps.map((step, index) => (
          <li>
            <span class="step-num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
