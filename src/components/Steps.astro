---
interface Step {
  title: string;
  text: string;
}

interface Props {
  steps: Step[];
  heading?: string;
}

const { steps, heading = "How it works" } = Astro.props;
---

<section class="section section-band">
  <div class="wrap">
    <h2>{heading}</h2>
    <p class="section-lede">Three short steps. No forms on this site.</p>
    <ol class="steps">
      {
        steps.map((step, index) => (
          <li>
            <p class="step-label">Step {index + 1}</p>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
