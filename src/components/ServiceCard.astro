---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  href: string;
  title: string;
  summary: string;
  image: ImageMetadata;
}

const { href, title, summary, image } = Astro.props;
---

<li>
  <a class="service-tile" href={href}>
    <Image
      src={image}
      alt=""
      widths={[400, 720]}
      sizes="(min-width: 1100px) 20rem, (min-width: 760px) 30vw, 100vw"
      quality={64}
      class="service-photo"
    />
    <span class="service-copy">
      <span class="service-title">{title}</span>
      <span class="service-summary">{summary}</span>
    </span>
  </a>
</li>
